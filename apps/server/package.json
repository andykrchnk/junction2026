{
    "name": "@repo/server",
    "private": true,
    "type": "module",
    "exports": {
        "./router": {
            "types": "./src/trpc/app.trpc.ts"
        }
    },
    "scripts": {
        "dev": "bun --env-file=../../.env --hot src/app/index.ts",
        "start": "bun dist/index.js",
        "build": "bun build src/app/index.ts --target=bun --outfile=dist/index.js",
        "check-types": "tsc --noEmit",
        "lint": "eslint src",
        "test": "bun test"
    },
    "dependencies": {
        "@hono/trpc-server": "0.4.2",
        "@repo/types": "workspace:*",
        "@trpc/server": "11.28.0",
        "hono": "^4.7.11",
        "mongodb": "^7.0.0",
        "zod": "^4.3.6",
        "better-auth": "1.7.23",
        "@better-auth/mongo-adapter": "1.7.23"
    },
    "devDependencies": {
        "@types/bun": "latest"
    }
}
