{
    "compilerOptions": {
        "target": "ES2023",
        "jsx": "react-jsx",
        "module": "ESNext",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": ["vite/client", "node"],
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "paths": {
            "@/*": ["./src/*"],
            "@/components/ui/*": ["../../design-system/src/components/ui/*"],
            "@/lib/*": ["../../design-system/src/lib/*"],
            "@/hooks/*": ["../../design-system/src/hooks/*"],
            "@/components/fluid-hover-highlight": ["../../design-system/src/components/fluid-hover-highlight.tsx"]
        }
    },
    "include": ["src", "vite.config.ts"]
}
