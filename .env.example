# Server only. Copy this file to .env; never commit real values.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=junction2026
APP_ORIGIN=http://localhost:3000
PORT=3001
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional until blueprint analysis/chat is used. Server only.
OPENAI_API_KEY=

# Optional processing service. Set URL and key together; server only.
INFERENCE_BASE_URL=
INFERENCE_API_KEY=
INFERENCE_TIMEOUT_MS=600000
# Maximum concurrent drawing stages per backend instance (1-32).
DRAWING_PROCESSING_CONCURRENCY=15
# Entity batch size per drawing stage (1-12), subject to the aggregate OpenAI limit.
DRAWING_ENTITY_CONCURRENCY=6
# Aggregate OpenAI analysis requests across all active drawings per backend instance.
DRAWING_OPENAI_CONCURRENCY=18
