{
    "name": "junction2026",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "prettier --write .",
        "check-types": "turbo run check-types",
        "format:check": "prettier --check .",
        "check-infra": "tsc --noEmit -p .railway/tsconfig.json",
        "prepare": "node -e \"if (require('node:fs').existsSync('.git')) require('node:child_process').execFileSync('git', ['config', 'core.hooksPath', '.githooks']);\"",
        "dev:platform": "pnpm --filter @repo/app dev --host 127.0.0.1",
        "dev:storybook": "npm --prefix design-system run storybook -- --ci --host 127.0.0.1",
        "dev:ui": "node scripts/dev-ui.mjs",
        "setup:ui": "pnpm install && npm --prefix design-system ci"
    },
    "devDependencies": {
        "@typescript/native": "npm:typescript@7.0.2",
        "eslint": "^9.39.4",
        "prettier": "3.9.6",
        "railway": "3.17.0",
        "turbo": "^2.11.11",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.65.0",
        "@types/node": "^24.0.0"
    },
    "packageManager": "pnpm@11.25.0",
    "engines": {
        "node": ">=24"
    }
}
