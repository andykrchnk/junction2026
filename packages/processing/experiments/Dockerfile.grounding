FROM junction-cubicasa:gpu-comparison
USER root
RUN pip install --no-cache-dir torchvision==0.20.1 --index-url https://download.pytorch.org/whl/cu124
RUN pip install --no-cache-dir transformers==4.49.0 hydra-core==1.3.2 iopath==0.1.10 huggingface-hub==0.29.3
COPY sam2 /opt/sam2
RUN SAM2_BUILD_CUDA=0 pip install --no-build-isolation --no-deps /opt/sam2
USER inference
